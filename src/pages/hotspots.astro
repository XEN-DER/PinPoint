---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Command Center - Pinpoint">
  <!-- Immersive Dark Theme Container -->
  <div class="bg-surface-dark min-h-screen text-on-dark overflow-hidden relative border-b border-hairline/10">
    
    <!-- Background Radar Animation -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0 flex items-center justify-center opacity-[0.15]">
      <div class="w-[1000px] h-[1000px] border border-brand-mint/20 rounded-full absolute animate-pulse"></div>
      <div class="w-[800px] h-[800px] border border-brand-mint/30 rounded-full animate-ping-slow absolute"></div>
      <div class="w-[600px] h-[600px] border border-brand-mint/40 rounded-full absolute"></div>
      <div class="w-[400px] h-[400px] border border-brand-mint/50 rounded-full absolute"></div>
      <div class="w-full h-[1px] bg-brand-mint/20 absolute top-1/2"></div>
      <div class="h-full w-[1px] bg-brand-mint/20 absolute left-1/2"></div>
    </div>

    <div class="max-w-[1280px] mx-auto px-6 py-16 relative z-10">
      
      <!-- Top Section -->
      <div class="text-center mb-20 animate-toast-slide-up">
        <span class="inline-block py-1.5 px-4 rounded-full bg-brand-mint/10 border border-brand-mint/30 text-brand-mint text-xs font-bold tracking-widest uppercase mb-6 shadow-[0_0_20px_rgba(164,212,197,0.2)]">
          Live Surveillance
        </span>
        <h1 class="text-[3.5rem] md:text-[5rem] font-display font-medium tracking-tight text-white mb-6 leading-none">
          Command Center
        </h1>
        <p class="text-on-dark-soft max-w-2xl mx-auto text-lg md:text-xl font-light">
          Real-time algorithmic prediction of civic infrastructure distress clusters.
        </p>
      </div>

      <!-- Middle Section: Metrics Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20 animate-toast-slide-up" style="animation-delay: 100ms;">
        <!-- Metric 1 -->
        <div class="bg-surface-dark-elevated/60 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl hover:border-brand-pink/30 hover:bg-surface-dark-elevated/80 transition-all duration-300 group cursor-default">
          <div class="text-on-dark-soft text-sm font-semibold tracking-wider uppercase mb-3">Active Clusters</div>
          <div class="text-5xl font-display font-medium text-white group-hover:text-brand-pink transition-colors duration-300">12</div>
        </div>
        <!-- Metric 2 -->
        <div class="bg-surface-dark-elevated/60 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl hover:border-brand-ochre/30 hover:bg-surface-dark-elevated/80 transition-all duration-300 group cursor-default">
          <div class="text-on-dark-soft text-sm font-semibold tracking-wider uppercase mb-3">Predicted Failures</div>
          <div class="text-5xl font-display font-medium text-white group-hover:text-brand-ochre transition-colors duration-300">7</div>
        </div>
        <!-- Metric 3 -->
        <div class="bg-surface-dark-elevated/60 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl hover:border-brand-mint/30 hover:bg-surface-dark-elevated/80 transition-all duration-300 group cursor-default">
          <div class="text-on-dark-soft text-sm font-semibold tracking-wider uppercase mb-3">Resolution Efficiency</div>
          <div class="text-5xl font-display font-medium text-white group-hover:text-brand-mint transition-colors duration-300">94%</div>
        </div>
      </div>

      <!-- Bottom Section -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 animate-toast-slide-up" style="animation-delay: 200ms;">
        
        <!-- Left: Threat Levels -->
        <div class="lg:col-span-7 bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 rounded-[2rem] p-8 md:p-10 shadow-2xl">
          <h2 class="text-title-lg font-display font-medium text-white mb-10 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-brand-coral/20 flex items-center justify-center text-brand-coral">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            Threat Level Analysis
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Threat 1 -->
            <div class="group bg-[#111111] p-6 rounded-2xl border border-hairline/10 hover:border-brand-pink/40 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_30px_rgba(255,107,90,0.15)] transition-all duration-300">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="text-white font-medium text-xl mb-1 group-hover:text-brand-pink transition-colors">Ajwa Road</h3>
                  <span class="text-xs text-on-dark-soft">Water Line Failures</span>
                </div>
                <span class="text-brand-pink text-[10px] font-bold tracking-widest uppercase bg-brand-pink/10 px-3 py-1.5 rounded-full shadow-[0_0_15px_rgba(255,107,90,0.3)] animate-pulse border border-brand-pink/20">Critical</span>
              </div>
              <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden shadow-inner">
                <div class="h-full bg-gradient-to-r from-brand-pink/40 to-brand-pink rounded-full relative group-hover:shadow-[0_0_20px_rgba(255,107,90,0.8)] transition-all duration-500 ease-out" style="width: 82%">
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-full animate-[shimmer_2s_infinite]"></div>
                </div>
              </div>
            </div>

            <!-- Threat 2 -->
            <div class="group bg-[#111111] p-6 rounded-2xl border border-hairline/10 hover:border-brand-ochre/40 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_30px_rgba(255,176,132,0.1)] transition-all duration-300">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="text-white font-medium text-xl mb-1 group-hover:text-brand-ochre transition-colors">Bapod</h3>
                  <span class="text-xs text-on-dark-soft">Pothole Fissures</span>
                </div>
                <span class="text-brand-ochre text-[10px] font-bold tracking-widest uppercase bg-brand-ochre/10 px-3 py-1.5 rounded-full border border-brand-ochre/20">Elevated</span>
              </div>
              <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden shadow-inner">
                <div class="h-full bg-gradient-to-r from-brand-ochre/40 to-brand-ochre rounded-full relative group-hover:shadow-[0_0_15px_rgba(255,176,132,0.6)] transition-all duration-500 ease-out" style="width: 58%"></div>
              </div>
            </div>

            <!-- Threat 3 -->
            <div class="group bg-[#111111] p-6 rounded-2xl border border-hairline/10 hover:border-brand-mint/40 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_30px_rgba(164,212,197,0.1)] transition-all duration-300">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="text-white font-medium text-xl mb-1 group-hover:text-brand-mint transition-colors">Waghodia Road</h3>
                  <span class="text-xs text-on-dark-soft">Waste Logistical Bottlenecks</span>
                </div>
                <span class="text-brand-mint text-[10px] font-bold tracking-widest uppercase bg-brand-mint/10 px-3 py-1.5 rounded-full border border-brand-mint/20">Stable</span>
              </div>
              <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden shadow-inner">
                <div class="h-full bg-gradient-to-r from-brand-mint/40 to-brand-mint rounded-full relative group-hover:shadow-[0_0_15px_rgba(164,212,197,0.6)] transition-all duration-500 ease-out" style="width: 25%"></div>
              </div>
            </div>
            
            <!-- Threat 4 (New to fill grid) -->
            <div class="group bg-[#111111] p-6 rounded-2xl border border-hairline/10 hover:border-brand-mint/40 hover:-translate-y-1 shadow-lg hover:shadow-[0_10px_30px_rgba(164,212,197,0.1)] transition-all duration-300">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h3 class="text-white font-medium text-xl mb-1 group-hover:text-brand-mint transition-colors">Kishanwadi</h3>
                  <span class="text-xs text-on-dark-soft">Streetlight Outages</span>
                </div>
                <span class="text-brand-mint text-[10px] font-bold tracking-widest uppercase bg-brand-mint/10 px-3 py-1.5 rounded-full border border-brand-mint/20">Stable</span>
              </div>
              <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden shadow-inner">
                <div class="h-full bg-gradient-to-r from-brand-mint/40 to-brand-mint rounded-full relative group-hover:shadow-[0_0_15px_rgba(164,212,197,0.6)] transition-all duration-500 ease-out" style="width: 12%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Predictive Timeline -->
        <div class="lg:col-span-5 relative mt-8 lg:mt-0">
          <h2 class="text-title-lg font-display font-medium text-white mb-10 pl-2">Predictive Alerts</h2>
          
          <div class="relative border-l-2 border-hairline/20 ml-6 space-y-12 pb-8">
            
            <!-- Alert 1 -->
            <div class="relative pl-10 group cursor-default">
              <div class="absolute -left-[21px] top-1 bg-surface-dark border-[3px] border-brand-coral w-10 h-10 rounded-full flex items-center justify-center shadow-[0_0_15px_rgba(255,107,90,0.4)] group-hover:scale-110 transition-transform duration-300">
                <svg class="w-4 h-4 text-brand-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              </div>
              <div class="bg-surface-dark-elevated/40 backdrop-blur-sm border border-brand-coral/30 p-6 rounded-2xl group-hover:border-brand-coral/70 transition-colors duration-300 shadow-xl relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-coral to-transparent"></div>
                <h4 class="text-white font-bold text-lg mb-3">Water mains recurrence in Ajwa Road</h4>
                <p class="text-sm text-on-dark-soft mb-5 leading-relaxed font-light">
                  Water pipe fractures detected 3 times within 150m. High probability of underlying ground instability.
                </p>
                <span class="inline-flex items-center gap-2 bg-brand-coral/10 text-brand-coral text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider border border-brand-coral/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-coral"></span>
                  Main Replacement Suggested
                </span>
              </div>
            </div>

            <!-- Alert 2 -->
            <div class="relative pl-10 group cursor-default">
              <div class="absolute -left-[21px] top-1 bg-surface-dark border-[3px] border-brand-ochre w-10 h-10 rounded-full flex items-center justify-center group-hover:shadow-[0_0_15px_rgba(255,176,132,0.4)] group-hover:scale-110 transition-all duration-300">
                <svg class="w-4 h-4 text-brand-ochre" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              </div>
              <div class="bg-surface-dark-elevated/40 backdrop-blur-sm border border-hairline/10 p-6 rounded-2xl group-hover:border-brand-ochre/40 transition-colors duration-300 shadow-xl relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-ochre to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <h4 class="text-white font-bold text-lg mb-3">Pothole hotspot cluster in Bapod</h4>
                <p class="text-sm text-on-dark-soft mb-5 leading-relaxed font-light">
                  Road surface degradation accelerated along Main Road. Traffic density modeling predicts secondary fissures.
                </p>
                <span class="inline-flex items-center gap-2 bg-brand-ochre/10 text-brand-ochre text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider border border-brand-ochre/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-ochre"></span>
                  Patching Scheduled
                </span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes ping-slow {
    0% { transform: scale(0.8); opacity: 0.5; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  .animate-ping-slow {
    animation: ping-slow 5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
</style>
