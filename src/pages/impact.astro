---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Analytics - Command Center">
  <div class="max-w-4xl mx-auto px-6 pt-12 pb-4 animate-toast-slide-up">
    <h1 class="text-[3.5rem] font-display font-medium text-white leading-none">Impact & Analytics</h1>
    <p class="text-on-dark-soft text-lg mt-4 font-light">See the real-time difference we are making in the community.</p>
  </div>
    <section id="analytics-section" class="relative bg-surface-dark py-16 px-6 sm:px-12 flex flex-col items-center text-center overflow-hidden scroll-mt-[52px]">
      <!-- Animated Background Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-pink/5 rounded-full blur-[120px] -z-10 animate-pulse pointer-events-none"></div>
      
      <div class="max-w-5xl mx-auto flex flex-col items-center relative z-10">
        <!-- Badge Pill -->
        <span class="text-brand-pink text-xs font-bold tracking-widest uppercase mb-6 bg-brand-pink/10 px-4 py-1.5 rounded-full border border-brand-pink/30 shadow-[0_0_15px_rgba(255,107,90,0.2)]">
          🌱 Hyperlocal Action Hub
        </span>
        
        <!-- Headline in Premium Gradient -->
        <h1 class="text-[4rem] text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-200 to-gray-400 leading-none font-medium mb-6 select-text tracking-[-2.5px] font-display">
          Civic Resolution Analytics
        </h1>
        
        <!-- Tagline -->
        <p class="text-on-dark-soft text-xl font-light mb-12 max-w-2xl leading-relaxed">
          Identify, report, and verify community issues. Connect with local municipal authorities in a transparent, warm, and collaborative ecosystem.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap justify-center gap-4 mb-20">
          <button 
            id="hero-report-btn" 
            class="bg-brand-mint text-surface-dark font-bold rounded-full px-8 py-3.5 hover:bg-white hover:shadow-[0_0_20px_rgba(164,212,197,0.6)] transition-all duration-300 hover:-translate-y-1"
          >
            Report an Issue
          </button>
          <a 
            href="#feed-section" 
            class="text-white border border-hairline/20 rounded-full px-8 py-3.5 hover:border-brand-mint/40 hover:bg-surface-dark-elevated transition-all duration-300 hover:-translate-y-1"
          >
            Explore Map & Feed
          </a>
        </div>

        <!-- Live Impact Stats Ticker (Glass Cards) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 w-full">
          <div class="bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl transition-all duration-300 hover:scale-105 group relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-pink/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="text-[3.5rem] text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 group-hover:from-brand-pink group-hover:to-red-400 transition-all duration-500 font-semibold font-display tracking-tight leading-none" id="ticker-reported">1,280</div>
            <div class="text-[10px] tracking-widest uppercase text-on-dark-soft font-bold mt-4">Issues Reported</div>
          </div>
          
          <div class="bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl transition-all duration-300 hover:scale-105 group relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-mint/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="text-[3.5rem] text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 group-hover:from-brand-mint group-hover:to-emerald-400 transition-all duration-500 font-semibold font-display tracking-tight leading-none" id="ticker-resolved">1,208</div>
            <div class="text-[10px] tracking-widest uppercase text-on-dark-soft font-bold mt-4">Problems Resolved</div>
          </div>
          
          <div class="bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl transition-all duration-300 hover:scale-105 group relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-coral/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="text-[3.5rem] text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 group-hover:from-brand-coral group-hover:to-orange-400 transition-all duration-500 font-semibold font-display tracking-tight leading-none" id="ticker-active">72</div>
            <div class="text-[10px] tracking-widest uppercase text-on-dark-soft font-bold mt-4">Active Reports</div>
          </div>
          
          <div class="bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl transition-all duration-300 hover:scale-105 group relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-success/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="text-[3.5rem] text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400 group-hover:from-success group-hover:to-green-400 transition-all duration-500 font-semibold font-display tracking-tight leading-none" id="ticker-rate">94%</div>
            <div class="text-[10px] tracking-widest uppercase text-on-dark-soft font-bold mt-4">Resolution Rate</div>
          </div>
        </div>
      </div>
    </section>
</Layout>
