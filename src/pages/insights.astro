---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Predictive Insights - Pinpoint">
  <!-- Immersive Dark Theme Container -->
  <div class="bg-surface-dark min-h-screen text-on-dark overflow-hidden relative border-b border-hairline/10">
    
    <!-- Background Animated Mesh -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0 flex items-center justify-center opacity-20">
      <div class="w-[800px] h-[800px] bg-brand-mint/5 blur-[120px] rounded-full absolute -top-40 -left-20 animate-pulse"></div>
      <div class="w-[600px] h-[600px] bg-brand-pink/5 blur-[100px] rounded-full absolute bottom-0 right-20 animate-pulse" style="animation-delay: 2s;"></div>
      
      <!-- Grid overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    </div>

    <div class="max-w-[1280px] mx-auto px-6 pt-16 pb-24 relative z-10">
      
      <!-- Top Section -->
      <div class="text-center mb-16 animate-toast-slide-up">
        <span class="inline-block py-1.5 px-4 rounded-full bg-brand-mint/10 border border-brand-mint/30 text-brand-mint text-xs font-bold tracking-widest uppercase mb-6 shadow-[0_0_20px_rgba(164,212,197,0.2)]">
          AI Forecasting Engine
        </span>
        <h1 class="text-[3.5rem] md:text-[4.5rem] font-display font-medium tracking-tight text-white mb-6 leading-none">
          Predictive Insights
        </h1>
        <p class="text-on-dark-soft max-w-2xl mx-auto text-lg md:text-xl font-light">
          Leveraging historical data and AI models to predict infrastructure deterioration before it happens.
        </p>
      </div>

      <!-- Main Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 animate-toast-slide-up" style="animation-delay: 150ms;">
        
        <!-- Left Column: Forecast & Resources (col-span-8) -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Infrastructure Deterioration Forecast -->
          <div class="bg-[#111111]/80 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl relative overflow-hidden group">
            <!-- Glow effect -->
            <div class="absolute -inset-1 bg-gradient-to-r from-brand-mint/0 via-brand-mint/5 to-brand-mint/0 opacity-0 group-hover:opacity-100 transition-opacity duration-1000 blur-xl"></div>
            
            <div class="relative z-10">
              <div class="flex justify-between items-center mb-8">
                <h2 class="text-2xl font-display font-medium text-white flex items-center gap-3">
                  <svg class="w-6 h-6 text-brand-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                  90-Day Deterioration Forecast
                </h2>
                <div class="flex gap-2">
                  <span class="text-xs font-mono px-2 py-1 rounded bg-surface-dark border border-hairline/10 text-on-dark-soft">Ajwa Rd</span>
                  <span class="text-xs font-mono px-2 py-1 rounded bg-brand-mint/20 border border-brand-mint/30 text-brand-mint font-bold shadow-[0_0_10px_rgba(164,212,197,0.2)]">Bapod</span>
                </div>
              </div>

              <!-- Simulated Chart -->
              <div class="h-64 flex items-end justify-between gap-2 border-b border-l border-hairline/20 pb-4 pl-4 relative">
                <!-- Y-axis labels -->
                <div class="absolute -left-2 top-0 h-full flex flex-col justify-between text-[10px] text-muted py-2 -translate-x-full">
                  <span>100%</span>
                  <span>75%</span>
                  <span>50%</span>
                  <span>25%</span>
                  <span>0%</span>
                </div>
                
                <!-- Bars (Bapod Forecast) -->
                <div class="w-full relative group/bar flex flex-col justify-end h-full">
                  <div class="bg-surface-dark-elevated border border-hairline/20 rounded-t-sm w-full transition-all duration-500 hover:bg-brand-ochre/20" style="height: 15%;"></div>
                  <span class="text-[10px] text-muted text-center mt-2 absolute -bottom-6 w-full">Week 1</span>
                </div>
                <div class="w-full relative group/bar flex flex-col justify-end h-full">
                  <div class="bg-surface-dark-elevated border border-hairline/20 rounded-t-sm w-full transition-all duration-500 hover:bg-brand-ochre/20" style="height: 22%;"></div>
                  <span class="text-[10px] text-muted text-center mt-2 absolute -bottom-6 w-full">Week 2</span>
                </div>
                <div class="w-full relative group/bar flex flex-col justify-end h-full">
                  <div class="bg-surface-dark-elevated border border-hairline/20 rounded-t-sm w-full transition-all duration-500 hover:bg-brand-ochre/20" style="height: 35%;"></div>
                  <span class="text-[10px] text-muted text-center mt-2 absolute -bottom-6 w-full">Week 3</span>
                </div>
                <div class="w-full relative group/bar flex flex-col justify-end h-full">
                  <div class="bg-surface-dark-elevated border border-hairline/20 rounded-t-sm w-full transition-all duration-500 hover:bg-brand-ochre/20" style="height: 48%;"></div>
                  <span class="text-[10px] text-muted text-center mt-2 absolute -bottom-6 w-full">Week 4</span>
                </div>
                <!-- Projected (Future) Bars -->
                <div class="w-full relative group/bar flex flex-col justify-end h-full">
                  <div class="bg-gradient-to-t from-brand-pink/10 to-brand-pink/40 border border-brand-pink/30 rounded-t-sm w-full transition-all duration-500 hover:bg-brand-pink/60 shadow-[0_0_15px_rgba(255,107,90,0.2)]" style="height: 65%;"></div>
                  <span class="text-[10px] text-brand-pink font-bold text-center mt-2 absolute -bottom-6 w-full">Week 5 (Est)</span>
                </div>
                <div class="w-full relative group/bar flex flex-col justify-end h-full">
                  <div class="bg-gradient-to-t from-brand-pink/10 to-brand-pink/50 border border-brand-pink/40 rounded-t-sm w-full transition-all duration-500 hover:bg-brand-pink/60 shadow-[0_0_15px_rgba(255,107,90,0.3)]" style="height: 82%;"></div>
                  <span class="text-[10px] text-brand-pink font-bold text-center mt-2 absolute -bottom-6 w-full">Week 6 (Est)</span>
                </div>
                
                <!-- Trend line (SVG overlay) -->
                <svg class="absolute inset-0 w-full h-full pointer-events-none" preserveAspectRatio="none" viewBox="0 0 100 100">
                  <path d="M 5 85 L 23 78 L 41 65 L 59 52 L 77 35 L 95 18" fill="none" stroke="url(#trend-gradient)" stroke-width="2" stroke-dasharray="4 2" class="animate-[dash_2s_linear_infinite]" />
                  <defs>
                    <linearGradient id="trend-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="rgba(164,212,197,0.5)" />
                      <stop offset="100%" stop-color="rgba(255,107,90,1)" />
                    </linearGradient>
                  </defs>
                </svg>
              </div>
              
              <div class="mt-10 p-4 bg-brand-pink/5 border border-brand-pink/20 rounded-xl flex items-start gap-4">
                <div class="mt-1 w-8 h-8 rounded-full bg-brand-pink/20 flex items-center justify-center flex-shrink-0 shadow-[0_0_15px_rgba(255,107,90,0.3)] text-brand-pink">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <div>
                  <h4 class="text-brand-pink font-bold text-sm uppercase tracking-widest mb-1">Critical Insight</h4>
                  <p class="text-sm text-on-dark-soft">Bapod exhibits an exponential risk curve for pothole cluster formation over the next 14 days due to recent heavy vehicular load combined with subsurface water accumulation.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Resource Deployment Optimizer -->
          <div class="bg-[#111111]/80 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl relative overflow-hidden">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-display font-medium text-white flex items-center gap-3">
                <svg class="w-6 h-6 text-brand-ochre" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                Resource Optimizer
              </h2>
            </div>
            
            <div class="space-y-4">
              <!-- Suggestion 1 -->
              <div class="p-5 border border-brand-ochre/30 bg-surface-dark-elevated rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(232,185,74,0.1)] transition-all duration-300">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-brand-ochre/10 rounded-full flex items-center justify-center border border-brand-ochre/30 shadow-[0_0_10px_rgba(232,185,74,0.2)]">
                    <span class="text-brand-ochre font-bold text-lg">T1</span>
                  </div>
                  <div>
                    <h4 class="text-white font-bold mb-1">Preemptively dispatch patching crew</h4>
                    <p class="text-xs text-on-dark-soft">Target: <strong class="text-white">Bapod Main Rd</strong> (Mitigate 25% predicted fissure increase)</p>
                  </div>
                </div>
                <button class="px-4 py-2 bg-brand-ochre hover:bg-brand-ochre/90 text-[#111] font-bold text-sm rounded-lg transition-colors active-scale whitespace-nowrap shadow-[0_0_15px_rgba(232,185,74,0.4)]">
                  Dispatch Crew
                </button>
              </div>

              <!-- Suggestion 2 -->
              <div class="p-5 border border-hairline/20 bg-surface-dark-elevated rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-brand-mint/10 rounded-full flex items-center justify-center border border-brand-mint/30">
                    <span class="text-brand-mint font-bold text-lg">T2</span>
                  </div>
                  <div>
                    <h4 class="text-white font-bold mb-1">Routine inspection routing</h4>
                    <p class="text-xs text-on-dark-soft">Target: <strong class="text-white">Waghodia Road</strong> (Waste management stabilization)</p>
                  </div>
                </div>
                <button class="px-4 py-2 bg-surface-dark hover:bg-brand-mint/20 border border-brand-mint/30 text-brand-mint font-bold text-sm rounded-lg transition-colors active-scale whitespace-nowrap">
                  Assign Route
                </button>
              </div>
            </div>
          </div>
          
        </div>
        
        <!-- Right Column: Seasonal & Confidence (col-span-4) -->
        <div class="lg:col-span-4 space-y-8">
          
          <!-- Seasonal Risk Module -->
          <div class="bg-[#111111]/80 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl">
            <h3 class="text-xl font-display font-medium text-white mb-6">Seasonal Risk Context</h3>
            
            <div class="relative bg-surface-dark rounded-2xl p-6 border border-hairline/20 mb-6 overflow-hidden">
              <!-- Rain animation effect -->
              <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjIwIj48cmVjdCB3aWR0aD0iMSIgaGVpZ2h0PSI4IiBmaWxsPSIjZmZmIiBvcGFjaXR5PSIwLjUiLz48L3N2Zz4=')] animate-[slideDown_2s_linear_infinite]"></div>
              
              <div class="flex items-center justify-between mb-4 relative z-10">
                <span class="text-brand-mint text-sm font-bold uppercase tracking-wider">Upcoming: Monsoon</span>
                <span class="text-xl">⛈️</span>
              </div>
              <div class="text-3xl font-display text-white mb-2 relative z-10">+45% Risk</div>
              <p class="text-xs text-on-dark-soft relative z-10">Historical data indicates a 45% surge in water leakage and road fissures during heavy precipitation months.</p>
            </div>
            
            <!-- Context tags -->
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 bg-surface-dark-elevated border border-hairline/20 text-xs text-white rounded-md">High Precipitation</span>
              <span class="px-3 py-1.5 bg-brand-pink/10 border border-brand-pink/30 text-xs text-brand-pink font-bold rounded-md shadow-[0_0_10px_rgba(255,107,90,0.1)]">Flood Zones Active</span>
              <span class="px-3 py-1.5 bg-surface-dark-elevated border border-hairline/20 text-xs text-white rounded-md">Soil Saturation</span>
            </div>
          </div>

          <!-- AI Confidence Scoring -->
          <div class="bg-[#111111]/80 backdrop-blur-xl border border-hairline/10 p-8 rounded-3xl shadow-2xl">
            <h3 class="text-xl font-display font-medium text-white mb-6">AI Confidence Metrics</h3>
            
            <div class="space-y-6">
              <!-- Metric 1 -->
              <div>
                <div class="flex justify-between text-sm mb-2">
                  <span class="text-white font-medium">Model Accuracy</span>
                  <span class="text-brand-mint font-mono font-bold">92.4%</span>
                </div>
                <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden">
                  <div class="h-full bg-brand-mint rounded-full shadow-[0_0_10px_rgba(164,212,197,0.5)]" style="width: 92.4%"></div>
                </div>
              </div>
              
              <!-- Metric 2 -->
              <div>
                <div class="flex justify-between text-sm mb-2">
                  <span class="text-white font-medium">Data Volume Score</span>
                  <span class="text-brand-mint font-mono font-bold">88.0%</span>
                </div>
                <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden">
                  <div class="h-full bg-brand-mint rounded-full shadow-[0_0_10px_rgba(164,212,197,0.5)]" style="width: 88%"></div>
                </div>
              </div>

              <!-- Metric 3 -->
              <div>
                <div class="flex justify-between text-sm mb-2">
                  <span class="text-white font-medium">Anomaly Detection</span>
                  <span class="text-brand-ochre font-mono font-bold">76.5%</span>
                </div>
                <div class="h-2 w-full bg-surface-dark rounded-full overflow-hidden">
                  <div class="h-full bg-brand-ochre rounded-full shadow-[0_0_10px_rgba(232,185,74,0.5)]" style="width: 76.5%"></div>
                </div>
              </div>
            </div>
            
            <p class="text-[10px] text-muted mt-6 text-center italic">
              Predictions are generated using gradient boosted trees trained on 3 years of civic reporting data.
            </p>
          </div>
          
        </div>
      </div>
      
    </div>
  </div>
</Layout>

<style>
  @keyframes slideDown {
    0% { background-position: 0 0; }
    100% { background-position: 0 100px; }
  }
  @keyframes dash {
    to { stroke-dashoffset: -20; }
  }
</style>
