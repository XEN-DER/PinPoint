---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Citizen Hub & Rewards - Command Center">
  <div class="max-w-[1280px] mx-auto px-6 pt-12 pb-4 animate-toast-slide-up">
    <h1 class="text-[3.5rem] font-display font-medium text-white leading-none">Citizen Hub & Rewards</h1>
    <p class="text-on-dark-soft text-lg mt-4 font-light">Earn points, maintain streaks, complete missions, and redeem local rewards.</p>
  </div>
  
  <section id="gamification-section" class="bg-surface-dark border-b border-hairline/10 py-8 px-6 sm:px-12 scroll-mt-[52px]">
    <div class="max-w-[1280px] mx-auto">
      
      <!-- Top Row: Profile & Leaderboard -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-12">
        
        <!-- Left Column: Citizen Gamification Stats -->
        <div class="lg:col-span-5 flex flex-col justify-between h-full">
          <!-- Citizen Profile Card (rounded-lg 16px) -->
          <div class="bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl h-full flex flex-col">
            <div class="flex items-center gap-4 mb-6 relative">
              <!-- Streak Badge (Absolute top right) -->
              <div class="absolute -top-4 -right-4 bg-[#111] border border-brand-coral/30 px-3 py-1.5 rounded-full shadow-[0_0_15px_rgba(255,107,90,0.2)] flex items-center gap-1.5 animate-pulse">
                <span class="text-brand-coral text-sm">🔥</span>
                <span class="text-white text-xs font-bold">3 Wk Streak</span>
              </div>

              <!-- Avatar circle -->
              <div id="profile-avatar" class="w-16 h-16 bg-brand-ochre text-surface-dark shadow-[0_0_15px_rgba(232,185,74,0.4)] rounded-full flex items-center justify-center font-bold text-2xl font-display">
                RV
              </div>
              <div>
                <h4 id="profile-name" class="text-2xl text-white font-medium mb-0.5">Ritvik Vedangi</h4>
                <p class="text-sm text-on-dark-soft font-light" id="profile-level-badge">Level 1: Civic Scout</p>
              </div>
            </div>

            <!-- Points Row -->
            <div class="flex justify-between items-end mb-8 bg-surface-dark/50 p-4 rounded-2xl border border-hairline/10">
              <div>
                <div class="text-[10px] uppercase tracking-widest text-on-dark-soft font-mono font-bold mb-1">Available Points</div>
                <div class="text-4xl text-brand-mint font-bold font-display" id="profile-points">350</div>
              </div>
              <div class="text-right">
                <div class="text-[10px] uppercase tracking-widest text-on-dark-soft font-mono font-bold mb-1">Lifetime Impact</div>
                <div class="text-xl text-white font-bold font-display">12 Issues</div>
              </div>
            </div>

            <!-- Next Level Progress Bar -->
            <div class="mb-8 mt-auto">
              <div class="flex justify-between text-sm text-white mb-2">
                <span class="font-bold text-on-dark-soft uppercase tracking-wider text-xs">Level Progress</span>
                <span class="text-brand-ochre font-bold text-xs" id="level-progress-text">350 / 450 pts</span>
              </div>
              <div class="h-3 w-full bg-surface-dark rounded-full overflow-hidden border border-hairline/10 shadow-inner">
                <div class="h-full bg-gradient-to-r from-brand-ochre/50 to-brand-ochre rounded-full relative shadow-[0_0_10px_rgba(232,185,74,0.5)] transition-all duration-300 animate-pulse" id="level-progress-bar" style="width: 77%"></div>
              </div>
            </div>

            <!-- Badges Grid (Premium visual chips) -->
            <div>
              <h5 class="text-xs font-bold text-on-dark-soft uppercase tracking-widest mb-4">Earned Badges</h5>
              <div class="flex flex-wrap gap-2.5" id="badges-container">
                <!-- Badge 1 -->
                <div class="group relative flex items-center gap-1.5 bg-surface-dark border border-hairline/10 hover:border-brand-ochre/40 px-3 py-2 rounded-lg text-white text-xs shadow-sm hover:shadow-[0_0_15px_rgba(232,185,74,0.2)] hover:-translate-y-0.5 transition-all duration-300 cursor-help">
                  <span class="text-base drop-shadow-md">🛡️</span>
                  <span class="font-bold text-white">Pothole Patrol</span>
                  <!-- Tooltip -->
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2 bg-[#111] border border-hairline/20 rounded text-[10px] text-on-dark-soft opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10 text-center">
                    Reported 5 authentic pothole issues.
                  </div>
                </div>
                <!-- Badge 2 -->
                <div class="group relative flex items-center gap-1.5 bg-surface-dark border border-hairline/10 hover:border-brand-mint/40 px-3 py-2 rounded-lg text-white text-xs shadow-sm hover:shadow-[0_0_15px_rgba(164,212,197,0.2)] hover:-translate-y-0.5 transition-all duration-300 cursor-help">
                  <span class="text-base drop-shadow-md">⚡</span>
                  <span class="font-bold text-white">Light Guardian</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2 bg-[#111] border border-hairline/20 rounded text-[10px] text-on-dark-soft opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10 text-center">
                    Verified 3 streetlight outages.
                  </div>
                </div>
                <!-- Badge 3 (Locked) -->
                <div class="group relative flex items-center gap-1.5 bg-surface-dark/50 border border-hairline/10 border-dashed px-3 py-2 rounded-lg text-xs opacity-50 select-none text-white cursor-help">
                  <span class="text-base grayscale">🌊</span>
                  <span class="font-semibold text-white">Water Guard 🔒</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2 bg-[#111] border border-brand-pink/30 rounded text-[10px] text-brand-pink opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10 text-center shadow-[0_0_10px_rgba(255,107,90,0.2)]">
                    Locked. Report 3 water leaks to unlock.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Locality Leaderboard -->
        <div class="lg:col-span-7 bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl flex flex-col justify-between h-full">
          <div>
            <h3 class="text-brand-mint text-xs tracking-widest uppercase font-bold mb-6 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
              This Month's Top Contributors
            </h3>
            
            <div class="flex flex-col gap-3" id="leaderboard-list">
              <!-- Leaderboard entries are populated by javascript -->
            </div>
          </div>

          <!-- Gamification Rules Hint -->
          <div class="mt-6 border-t border-hairline/10 pt-6 text-sm text-on-dark-soft flex justify-between items-center">
            <span>Verify reports to earn +15 pts. Report an issue to earn +100 pts.</span>
            <span class="text-brand-mint font-medium cursor-pointer hover:underline">Rules Handbook →</span>
          </div>
        </div>
      </div>

      <!-- Bottom Row: Missions & Rewards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Weekly Civic Missions -->
        <div class="bg-surface-dark-elevated/20 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl">
          <h3 class="text-xl font-display text-white mb-6 flex items-center gap-2">
            <span class="text-brand-ochre">🎯</span> Weekly Civic Missions
          </h3>
          
          <div class="space-y-4">
            <!-- Mission 1 -->
            <div class="bg-[#111] border border-hairline/10 rounded-2xl p-5 hover:border-brand-ochre/30 transition-colors">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <h4 class="text-white font-bold">First Responder</h4>
                  <p class="text-xs text-on-dark-soft mt-1">Verify 3 newly reported civic issues.</p>
                </div>
                <div class="bg-brand-ochre/10 text-brand-ochre font-bold text-xs px-3 py-1 rounded-full border border-brand-ochre/20">
                  +50 pts
                </div>
              </div>
              <div class="mt-4">
                <div class="flex justify-between text-[10px] text-on-dark-soft mb-1 font-bold">
                  <span>Progress</span>
                  <span class="text-white">2 / 3</span>
                </div>
                <div class="h-1.5 w-full bg-surface-dark rounded-full overflow-hidden">
                  <div class="h-full bg-brand-ochre rounded-full" style="width: 66%"></div>
                </div>
              </div>
            </div>

            <!-- Mission 2 -->
            <div class="bg-[#111] border border-hairline/10 rounded-2xl p-5 hover:border-brand-mint/30 transition-colors relative overflow-hidden group">
              <!-- Glow on completion -->
              <div class="absolute inset-0 bg-brand-mint/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              
              <div class="flex justify-between items-start mb-2 relative z-10">
                <div>
                  <h4 class="text-white font-bold">Neighborhood Watch</h4>
                  <p class="text-xs text-on-dark-soft mt-1">Report an issue in an active predictive hotspot.</p>
                </div>
                <div class="bg-brand-mint/10 text-brand-mint font-bold text-xs px-3 py-1 rounded-full border border-brand-mint/20">
                  +100 pts
                </div>
              </div>
              <div class="mt-4 relative z-10">
                <div class="flex justify-between text-[10px] text-on-dark-soft mb-1 font-bold">
                  <span>Progress</span>
                  <span class="text-brand-mint">Completed!</span>
                </div>
                <div class="h-1.5 w-full bg-surface-dark rounded-full overflow-hidden">
                  <div class="h-full bg-brand-mint rounded-full shadow-[0_0_10px_rgba(164,212,197,0.8)]" style="width: 100%"></div>
                </div>
                <button class="mt-4 w-full bg-brand-mint hover:bg-brand-mint-active text-[#111] font-bold text-sm py-2 rounded-lg transition-colors active-scale">
                  Claim Reward
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Rewards & Redemption Store -->
        <div class="bg-surface-dark-elevated/20 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl">
          <h3 class="text-xl font-display text-white mb-6 flex items-center gap-2">
            <span class="text-brand-pink">🎁</span> Civic Rewards Store
          </h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Reward 1 (Affordable) -->
            <div class="group bg-[#111] border border-brand-mint/20 rounded-2xl p-5 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(164,212,197,0.1)] transition-all duration-300 flex flex-col justify-between cursor-pointer">
              <div>
                <div class="w-10 h-10 bg-brand-mint/10 rounded-full flex items-center justify-center text-brand-mint mb-3 border border-brand-mint/30">
                  🎫
                </div>
                <h4 class="text-white font-bold text-sm mb-1">1-Day Metro Pass</h4>
                <p class="text-[10px] text-on-dark-soft line-clamp-2">Free public transit access for 24 hours across the city network.</p>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-hairline/20 pt-3">
                <span class="text-brand-mint font-bold text-sm">300 pts</span>
                <span class="text-xs text-white bg-brand-mint/20 px-2 py-1 rounded group-hover:bg-brand-mint group-hover:text-[#111] transition-colors font-bold">Redeem</span>
              </div>
            </div>

            <!-- Reward 2 (Locked/Unaffordable) -->
            <div class="group bg-[#111] border border-hairline/10 rounded-2xl p-5 opacity-70 hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between cursor-not-allowed">
              <div>
                <div class="w-10 h-10 bg-surface-dark rounded-full flex items-center justify-center text-on-dark-soft mb-3 border border-hairline/20 grayscale">
                  🅿️
                </div>
                <h4 class="text-white font-bold text-sm mb-1">VIP Parking Token</h4>
                <p class="text-[10px] text-on-dark-soft line-clamp-2">Reserved municipal parking access in downtown zones.</p>
              </div>
              <div class="mt-4 flex items-center justify-between border-t border-hairline/20 pt-3">
                <span class="text-on-dark-soft font-bold text-sm">500 pts</span>
                <span class="text-[10px] text-brand-pink font-bold uppercase tracking-widest">Locked</span>
              </div>
            </div>

            <!-- Reward 3 (Locked/Unaffordable) -->
            <div class="sm:col-span-2 group bg-[#111] border border-hairline/10 rounded-2xl p-5 opacity-70 hover:opacity-100 transition-opacity duration-300 flex flex-row items-center justify-between cursor-not-allowed">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-surface-dark rounded-full flex items-center justify-center text-on-dark-soft border border-hairline/20 grayscale text-xl">
                  🏛️
                </div>
                <div>
                  <h4 class="text-white font-bold text-sm mb-1">2% Property Tax Rebate</h4>
                  <p class="text-[10px] text-on-dark-soft">Exclusive annual discount for Top Citizens.</p>
                </div>
              </div>
              <div class="text-right">
                <div class="text-on-dark-soft font-bold text-sm mb-1">5000 pts</div>
                <div class="text-[10px] text-brand-pink font-bold uppercase tracking-widest">Locked</div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
