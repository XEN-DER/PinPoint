---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Top Citizens - Command Center">
  <div class="max-w-4xl mx-auto px-6 pt-12 pb-4 animate-toast-slide-up">
    <h1 class="text-[3.5rem] font-display font-medium text-white leading-none">Leaderboard</h1>
    <p class="text-on-dark-soft text-lg mt-4 font-light">Earn points and rank up by reporting and verifying issues.</p>
  </div>
    <section id="gamification-section" class="bg-surface-dark border-b border-hairline/10 py-8 px-6 sm:px-12 scroll-mt-[52px]">
      <div class="max-w-[1280px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
          
          <!-- Left Column: Citizen Gamification Stats -->
          <div class="lg:col-span-5 flex flex-col justify-between">
            <div>
              <span class="text-brand-ochre text-xs tracking-widest uppercase font-bold mb-4 block">CITIZEN EMPOWERMENT</span>
              <h2 class="text-[2.5rem] text-white font-medium mb-4 font-display tracking-tight">
                Your Civic Dashboard
              </h2>
              <p class="text-on-dark-soft text-lg font-light mb-8 leading-relaxed">
                Earn points and unlock historic B2B badges by reporting real issues, verifying community posts, and following up on municipal actions.
              </p>
            </div>

            <!-- Citizen Profile Card (rounded-lg 16px) -->
            <div class="bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl">
              <div class="flex items-center gap-4 mb-6">
                <!-- Avatar circle -->
                <div id="profile-avatar" class="w-12 h-12 bg-brand-ochre text-surface-dark shadow-[0_0_15px_rgba(232,185,74,0.4)] rounded-full flex items-center justify-center font-bold text-lg font-display">
                  RV
                </div>
                <div>
                  <h4 id="profile-name" class="text-xl text-white font-medium mb-0.5">Ritvik Vedangi</h4>
                  <p class="text-xs text-on-dark-soft font-light" id="profile-level-badge">Level 1: Civic Scout</p>
                </div>
                <!-- Points -->
                <div class="ml-auto text-right">
                  <div class="text-3xl text-brand-ochre font-bold font-display" id="profile-points">350</div>
                  <div class="text-[10px] uppercase tracking-widest text-on-dark-soft font-mono font-bold mt-1">Civic Points</div>
                </div>
              </div>

              <!-- Next Level Progress Bar -->
              <div class="mb-6">
                <div class="flex justify-between text-sm text-white mb-2">
                  <span class="font-bold">Level Progress</span>
                  <span class="text-on-dark-soft font-light" id="level-progress-text">350 / 450 pts</span>
                </div>
                <div class="h-2.5 w-full bg-surface-dark rounded-full overflow-hidden border border-hairline/10 shadow-inner">
                  <div class="h-full bg-gradient-to-r from-brand-ochre/50 to-brand-ochre rounded-full relative shadow-[0_0_10px_rgba(232,185,74,0.5)] transition-all duration-300 animate-pulse" id="level-progress-bar" style="width: 77%"></div>
                </div>
              </div>

              <!-- Badges Grid (Premium visual chips) -->
              <div>
                <h5 class="text-xs font-bold text-on-dark-soft uppercase tracking-widest mb-4">Earned Badges</h5>
                <div class="flex flex-wrap gap-2.5" id="badges-container">
                  <!-- Badge 1 -->
                  <div class="flex items-center gap-1.5 bg-surface-dark border border-hairline/10 hover:border-brand-ochre/40 px-3 py-2 rounded-lg text-white text-xs shadow-sm hover:shadow-[0_0_15px_rgba(232,185,74,0.2)] hover:-translate-y-0.5 transition-all duration-300 cursor-default">
                    <span class="text-base drop-shadow-md">🛡️</span>
                    <span class="font-bold text-white">Pothole Patrol</span>
                  </div>
                  <!-- Badge 2 -->
                  <div class="flex items-center gap-1.5 bg-surface-dark border border-hairline/10 hover:border-brand-mint/40 px-3 py-2 rounded-lg text-white text-xs shadow-sm hover:shadow-[0_0_15px_rgba(164,212,197,0.2)] hover:-translate-y-0.5 transition-all duration-300 cursor-default">
                    <span class="text-base drop-shadow-md">⚡</span>
                    <span class="font-bold text-white">Light Guardian</span>
                  </div>
                  <!-- Badge 3 (Locked) -->
                  <div class="flex items-center gap-1.5 bg-surface-dark/50 border border-hairline/10 border-dashed px-3 py-2 rounded-lg text-xs opacity-50 select-none text-white">
                    <span class="text-base">🌊</span>
                    <span class="font-semibold text-white">Water Guard (Locked)</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Locality Leaderboard -->
          <div class="lg:col-span-7 bg-surface-dark-elevated/40 backdrop-blur-md border border-hairline/10 p-8 rounded-3xl shadow-xl flex flex-col justify-between">
            <div>
              <h3 class="text-brand-mint text-xs tracking-widest uppercase font-bold mb-6">
                This Month's Top Contributors
              </h3>
              
              <div class="flex flex-col gap-3" id="leaderboard-list">
                <!-- Leaderboard entries are populated by javascript -->
              </div>
            </div>

            <!-- Gamification Rules Hint -->
            <div class="mt-6 border-t border-hairline/10 pt-6 text-sm text-on-dark-soft flex justify-between items-center">
              <span>Verify reports to earn +15 pts. Report an issue to earn +100 pts.</span>
              <span class="text-brand-mint font-medium cursor-pointer hover:underline">Rules Handbook →</span>
            </div>
          </div>

        </div>
      </div>
    </section>
</Layout>
